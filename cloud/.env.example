# FreeSwarm cloud service env. Set these in the Vercel project (Settings > Environment Variables).

# Neon Postgres connection string (pooled "-pooler" host recommended for serverless).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/freeswarm?sslmode=require

# Secret used to sign the bearer JWT handed to desktop + web after sign-in.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# Web app origin allowed to call this API from the browser (CORS).
WEB_APP_ORIGIN=https://freeswarm.myndlabs.tech

# Google OAuth (sign-in). Until set, /api/auth/google returns 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.freeswarm.myndlabs.tech/api/auth/google

# Stripe billing. Until set, /api/billing/portal returns 501 and sync stays a no-op.
STRIPE_SECRET_KEY=
STRIPE_PORTAL_RETURN_URL=https://freeswarm.myndlabs.tech/app

# Dev-only: when "1", /api/auth/dev-login mints a token for any email (no OAuth).
# Leave UNSET in production.
ALLOW_DEV_LOGIN=
